# Copy to apps/web/.env.local AND apps/server/.env, then fill in.

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable__xxxxxxx
