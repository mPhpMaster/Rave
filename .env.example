# Copy to apps/web/.env.local AND apps/server/.env, then fill in.

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Optional: LiveKit voice. Leave blank to hide the voice panel.
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud

# ---- Server (apps/server/.env) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Optional: LiveKit voice. Required to mint tokens for the /livekit-token route.
LIVEKIT_API_KEY=YOUR-LIVEKIT-API-KEY
LIVEKIT_API_SECRET=YOUR-LIVEKIT-API-SECRET
# Optional: Redis for multi-instance Socket.IO. Leave blank for single-instance.
REDIS_URL=redis://localhost:6379
