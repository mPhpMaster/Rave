SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Optional: LiveKit voice. Required to mint tokens for the /livekit-token route.
LIVEKIT_API_KEY=YOUR-LIVEKIT-API-KEY
LIVEKIT_API_SECRET=YOUR-LIVEKIT-API-SECRET

# Optional: Redis. When set, Socket.IO uses the Redis adapter so multiple
# server instances broadcast across nodes. Leave blank for single-instance.
REDIS_URL=redis://localhost:6379
